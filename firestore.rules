// Bezpecnostni pravidla pro Firestore.
//
// Nasazeni: Firebase konzole → Firestore Database → Rules → vloz obsah
// tohoto souboru a klikni Publish. Soubor v repu slouzi jako zdroj pravdy
// k tomu, co ma byt v projektu nastavene.
//
// ── Kdo je admin ──────────────────────────────────────────────────────
// Zapisovat smi jen ucet, ktery ma svuj dokument v kolekci admins.
// Nestaci byt prihlaseny: kdokoli si totiz muze pomoci verejneho API klice
// ze zdrojaku stranky zalozit ucet, a "request.auth != null" by mu tim
// padem dalo pravo prepisovat blog i turnaje.
//
// Admina pridas v konzoli: Firestore → kolekce "admins" → novy dokument,
// jehoz ID je UID uctu (najdes v Authentication → Users). Obsah dokumentu
// je jedno, staci treba pole "email" pro prehled.
//
// Kolekce admins zamerne neni verejne citelna a nikdo do ni nesmi zapisovat
// z aplikace — meni se jen rucne z konzole.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
             && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Prispevky — verejne jen zverejnene, koncepty vidi jen admin.
    match /posts/{postId} {
      allow read:  if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // Sekce blogu — nazvy stitku, podle kterych se na webu filtruje.
    // Cist je muze kdokoli (potrebuje je verejna podstranka blogu),
    // menit jen admin.
    match /blogSections/{sectionId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // Turnaje — stejny princip jako prispevky.
    match /tournaments/{tournamentId} {
      allow read:  if resource.data.published == true || isAdmin();
      allow write: if isAdmin();

      // Predregistrace. Jedine misto, kam smi zapsat i neprihlaseny
      // navstevnik, proto je zapis omezeny co nejtesneji:
      //   - jen tri ocekavana pole, nic navic
      //   - jmeno 2–40 znaku, poznamka nejvys 120
      //   - createdAt musi byt cas serveru, ne hodnota od klienta
      //   - turnaj musi existovat, byt zverejneny, jeste se nekonat
      //     a nesmi mit uzavrenou registraci (capacity == 0)
      // Menit uz zapsanou registraci nesmi nikdo, mazat jen admin.
      function tournament() {
        return get(/databases/$(database)/documents/tournaments/$(tournamentId)).data;
      }
      match /registrations/{registrationId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['name', 'note', 'createdAt'])
                      && request.resource.data.keys().hasAll(['name', 'createdAt'])
                      && request.resource.data.name is string
                      && request.resource.data.name.size() >= 2
                      && request.resource.data.name.size() <= 40
                      && (!('note' in request.resource.data)
                          || (request.resource.data.note is string
                              && request.resource.data.note.size() <= 120))
                      && request.resource.data.createdAt == request.time
                      && tournament().published == true
                      && tournament().date > request.time
                      // capacity == 0 znamena, ze admin registraci uzavrel
                      && !(tournament().get('capacity', -1) == 0);
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // Plne verze fotek z galerie. Ctou se az pri otevreni lightboxu,
    // proto jsou v samostatne kolekci a ne primo u prispevku.
    // Nahledy (thumb) lezi v poli gallery u prispevku a ridi se pravidly vyse.
    //
    // Dokument je rozdeleny na dve casti:
    //   postImages/{id}           metadata — podle nich admin pozna,
    //                             ktere fotky uz nepatri k zadnemu prispevku
    //   postImages/{id}/data/full samotna base64 data
    //
    // Obe casti nesou priznak published zkopirovany z prispevku, takze
    // fotky z nezverejneneho konceptu nejsou verejne — a overeni nestoji
    // zadne cteni navic, protoze se ptame primo dokumentu, ktery se cte.
    match /postImages/{imageId} {
      allow read:  if resource.data.published == true || isAdmin();
      allow write: if isAdmin();

      match /data/{part} {
        allow read:   if resource.data.published == true || isAdmin();
        allow delete: if isAdmin();
        allow create, update: if isAdmin()
                              && request.resource.data.data is string
                              && request.resource.data.data.size() < 1000000;
      }
    }

    // Vse ostatni je zavrene.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
